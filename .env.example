VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# TURN is required for reliable WebRTC across symmetric NAT, carrier-grade NAT,
# restrictive corporate networks, and UDP-blocked connections. Supply at least
# one UDP and one TLS/TCP URL from your TURN provider.
# Example: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Recommended: URL of the Cloudflare Worker that mints short-lived TURN
# credentials. This takes precedence over static TURN credentials above.
#example : VITE_TURN_CREDENTIALS_URL=https://p2p-share-turn-credentials.<account>.workers.dev
VITE_TURN_CREDENTIALS_URL=



